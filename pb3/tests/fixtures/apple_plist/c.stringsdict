<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>apples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apples@</string>
		<key>NSStringPluralRuleZero</key>
		<string>Không có quả táo nào</string>
		<key>NSStringPluralRuleOne</key>
		<string>Một quả táo</string>
		<key>NSStringPluralRuleOther</key>
		<string>%d quả táo</string>
	</dict>
	<key>days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>NSStringPluralRuleOne</key>
		<string>Một ngày</string>
		<key>NSStringPluralRuleOther</key>
		<string>%d ngày</string>
	</dict>
</dict>
</plist>
